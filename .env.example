# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: your deployed URL, used for SEO metadata, sitemap and robots.txt
NEXT_PUBLIC_SITE_URL=https://your-portfolio.vercel.app

# --- Admin login (created automatically on every `npm run build`) -----------
# Service role / secret key: Supabase → Project Settings → API Keys.
# SECRET: never prefix with NEXT_PUBLIC_, never commit it. Only the build
# script (scripts/seed-admin.mjs) uses it; the website itself never does.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Your admin sign-in for /admin/login. Changing the password here and
# rebuilding changes it in Supabase. Leave all three empty to skip.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password
