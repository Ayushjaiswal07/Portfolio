# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...). The legacy "anon" key also works until
# Supabase retires it. This key is meant to be public; RLS protects your data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key

# Your site's URL, used for SEO metadata, sitemap and robots.txt.
# http://localhost:3000 locally; your Vercel URL or custom domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional: automatic admin login -----------------------------------------
# Not needed if you created your admin by hand in Supabase (README step 2, option A).
# If you use it, set ALL three: every `npm run build` then creates/updates this
# admin user. Setting only some of them makes the build fail.
# SUPABASE_SERVICE_ROLE_KEY is a full-access SECRET (sb_secret_... or legacy
# service_role): never prefix it with NEXT_PUBLIC_, never commit it.
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-key
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=change-me-to-a-strong-password
